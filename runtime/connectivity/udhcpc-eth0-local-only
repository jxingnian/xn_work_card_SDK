#!/bin/sh

# 要求 DHCP 客户端明确提供目标以太网接口。
if [ -z "${interface:-}" ]; then
    # 缺少接口时拒绝修改任何网络状态。
    exit 1
fi

# 根据 BusyBox udhcpc 事件更新本地调试接口。
case "${1:-}" in
    deconfig)
        # 租约失效时清除旧 IPv4 地址。
        ifconfig "$interface" 0.0.0.0 up
        ;;
    bound|renew)
        # DHCP 响应必须包含有效地址和子网掩码。
        if [ -z "${ip:-}" ] || [ -z "${subnet:-}" ]; then
            # 不完整租约不能用于配置本地调试接口。
            exit 1
        fi

        # 只配置局域网地址和直连路由，不接受 DHCP 下发的默认网关。
        ifconfig "$interface" "$ip" netmask "$subnet" up

        # 删除历史 DHCP 流程可能残留的有线默认路由。
        ip route del default dev "$interface" 2>/dev/null || true
        ;;
    *)
        # 其他 DHCP 事件不需要修改接口状态。
        ;;
esac

# 返回事件处理成功。
exit 0
